#!/bin/bash
set -e
MODE="${1:-full}"
shift 2>/dev/null || true
PROMPT="${*:-Describe in detail what you see on this computer screen}"

TDIR=$(mktemp -d /tmp/opencode-see-XXX)
trap "rm -rf '$TDIR'" EXIT

SS_DIR="$HOME/Pictures/opencode-ss"
mkdir -p "$SS_DIR"
TS=$(date +%Y%m%d-%H%M%S)
FNAME="ss-$TS.jpg"
FPATH="$SS_DIR/$FNAME"

case "$MODE" in
  region) grim -g "$(slurp)" "$TDIR/s.png" ;;
  window) grim -g "$(hyprctl activewindow -j | python3 -c "import sys,json;w=json.load(sys.stdin);print(f'{w[\"at\"][0]},{w[\"at\"][1]} {w[\"size\"][0]}x{w[\"size\"][1]}')")" "$TDIR/s.png" ;;
  left) grim -o "$LEFT_MON" "$TDIR/s.png" ;;
  right) grim -o "$RIGHT_MON" "$TDIR/s.png" ;;
  *) grim "$TDIR/s.png" 2>/dev/null || grim -o "$LEFT_MON" "$TDIR/s.png" ;;
esac

convert "$TDIR/s.png" -resize 1024x1024\> "$FPATH" 2>/dev/null || cp "$TDIR/s.png" "$FPATH"

MODEL="${VISION_MODEL:-qwen2.5vl:7b}"

LATEST_SS_PATH="${XDG_RUNTIME_DIR:-/tmp}/opencode-latest-ss-path"
echo "$FPATH" > "$LATEST_SS_PATH"
echo "Screen capture: $FPATH"

export PYPROMPT="$PROMPT" PYPATH="$FPATH" PYMODEL="$MODEL"
python3 << 'PYEOF'
import base64, json, ssl, urllib.request, os

with open(os.environ['PYPATH'], 'rb') as f:
    b64 = base64.b64encode(f.read()).decode()

payload = json.dumps({
    'model': os.environ['PYMODEL'],
    'prompt': os.environ['PYPROMPT'],
    'stream': False,
    'options': {'num_ctx': 4096},
    'images': [b64]
}).encode()

req = urllib.request.Request('http://127.0.0.1:11434/api/generate',
                           data=payload,
                           headers={'Content-Type': 'application/json'})
ctx = ssl.create_default_context()
r = json.loads(urllib.request.urlopen(req, timeout=120, context=ctx).read())
print(r.get('response', '').strip())
PYEOF
